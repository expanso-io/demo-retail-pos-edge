# The shared default lives in ../_demo-kit/.env and is never copied here.
#
# Only use a separate workspace when the demo genuinely requires one. Keep its
# credential file owner-only and make both overrides explicit:
#
# uv run -s ../_demo-kit/expanso-demo-init.py . \
#   --workspace-env /secure/path/workspace.env \
#   --profile customer-demo
