# Project-local secrets for this demo. Never commit the real file.
#
#   cp env.example .env && chmod 600 .env
#
# demo.sh refuses a .env that is not owner-only and reads nothing outside
# this checkout: no ~/.expanso profile, no global CLI settings.

# Expanso Cloud workspace (only for `just up`; `just up-local` needs none).
# Workspace Overview > API Access shows the endpoint.
EXPANSO_CLI_ENDPOINT=https://YOUR_WORKSPACE_ID.YOUR_REGION.cloud.expanso.io:9010
# Keys tab > API Keys. Starts with exp_ak_
EXPANSO_CLI_API_KEY=exp_ak_REPLACE_ME
# Keys tab > Bootstrap Tokens. Starts with exp_bk_. Used once per store
# node; the node identities then live in .cloud-state/ (ignored).
EXPANSO_EDGE_BOOTSTRAP_TOKEN=exp_bk_REPLACE_ME

# Generated by demo.sh on first run; leave them out:
# JOIN_ID_KEY        the group's join key (the jid1 algorithm's secret)
# REGISTER_KEY_SEED  derives each till's enrolled signing key
